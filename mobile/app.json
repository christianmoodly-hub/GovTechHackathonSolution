{
  "expo": {
    "name": "NCAP Career Advice",
    "slug": "ncap-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ncap",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/auth/brand-logo.png",
    "splash": {
      "image": "./assets/auth/brand-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#006A4E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.gov.ncap.careeradvice",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Khetha uses your location to show nearby public universities and TVET colleges on the DHET register.",
        "NSMicrophoneUsageDescription": "Khetha uses your microphone so you can speak to the career assistant instead of typing."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/auth/brand-logo.png",
        "backgroundColor": "#006A4E"
      },
      "package": "za.gov.ncap.careeradvice",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "ncap"
            },
            {
              "scheme": "https",
              "host": "nationalcreeradviceapp.firebaseapp.com",
              "pathPrefix": "/auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#006A4E"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Khetha to use your location to find nearby DHET learning providers."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Khetha to use your microphone so you can speak to the career assistant."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fecf94a1-65e1-4c15-8a6e-a63443f5ccd1"
      }
    },
    "owner": "mn15loner"
  }
}
