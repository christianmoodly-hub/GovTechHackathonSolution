# Firebase web config (Firebase Console → Project settings → Your apps)
# Restrict this key in Google Cloud Console (API restrictions + app restrictions).
EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=nationalcreeradviceapp.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nationalcreeradviceapp
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=nationalcreeradviceapp.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1059931069454
EXPO_PUBLIC_FIREBASE_APP_ID=1:1059931069454:web:fbd7688ef75d973af8f05f
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-LJ93RX72M7

# Google Sign-In (Firebase Console → Authentication → Sign-in method → Google → Web client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1059931069454-pl4qegd1fv7nhsmesdftcav6gs2f100h.apps.googleusercontent.com

# Email verification uses Firebase Auth sendEmailVerification (no third-party OTP provider).
# Optional deep-link override for the verification email continue URL:
# EXPO_PUBLIC_EMAIL_VERIFY_CONTINUE_URL=https://nationalcreeradviceapp.firebaseapp.com

# Google Maps — Geocoding API only (Near Me on Learning Providers).
# Enable "Geocoding API" in Google Cloud Console, create a key, restrict to Geocoding API.
# Restart Expo after changing this value.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Khetha assistant (Firebase AI Logic → Gemini Developer API backend).
# Enable it once per project: Firebase Console → Build → AI Logic → Get started.
# No extra key is needed; the Firebase web API key above authorises the calls.
# EXPO_PUBLIC_ASSISTANT_MODEL=gemini-3.6-flash
#
# App Check for assistant calls. The Firebase JS SDK has no Play Integrity
# provider for React Native, so on device we replay a debug token:
# Firebase Console → App Check → Apps → Manage debug tokens.
# Leave blank to skip App Check entirely (keep enforcement off while blank).
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# ---------------------------------------------------------------------------
# Qfrency TTS (server-side only — never put the API key in EXPO_PUBLIC_*)
# ---------------------------------------------------------------------------
# The mobile app calls the Firebase callable `synthesizeSpeech`, which talks
# to https://tts.qfrency.com with the secret key.
#
# 1. Email info@qfrency.com (CSIR Voice Computing) for AccountID + API key +
#    synthesis tokens. Demo voices: https://qfrency.com/demo/
# 2. From the repo root, after `firebase login`:
#      firebase functions:secrets:set QFRENCY_API_KEY
# 3. Deploy:
#      cd functions && npm install && npm run build
#      firebase deploy --only functions
# 4. Docs: https://tts.qfrency.com/docs
#
# Until the function is deployed / the key is set, the assistant still answers
# in text and shows a short “spoken replies unavailable” notice.
